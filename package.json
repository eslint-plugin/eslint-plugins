{
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*"
    ]
  },
  "type": "module",
  "scripts": {
    "lint": "oxlint",
    "format": "oxfmt",
    "build": "bun run --parallel --filter='./packages/**' build",
    "test": "bun run --filter='./packages/**' test"
  },
  "devDependencies": {
    "@gameroman/config": "0.3.0",
    "@types/bun": "1.4.4",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "tsdown": "0.23.1",
    "typescript": "6.0.3"
  }
}
